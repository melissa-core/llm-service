<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      F-028 TABLE BASELINE for llm-service (DB: llm_db).
      16 entity tables + 16 PKs (14 identity ids + chat_state.chat_id / settings.customer_id plain-bigint PKs),
      9 FKs and 17 CHECK constraints as guarded Liquibase changesets: MARK_RAN no-op on live, full build on a
      fresh DB. Included in db.changelog-master.xml BEFORE 001-add-indexes.xml (fresh-DB ordering fix; 001
      unchanged). SCOPE (D-0015): TABLE BASELINE ONLY - NO indexes of any kind (all 24 live standalone indexes
      are 001-managed, verified 1:1); NO unique constraints exist on live and none are added. Live column
      DEFAULTs are copied exactly (9 columns: numeric literals + memory_enabled boolean false). CHECKs are
      authored as col IN ('...') which round-trips to the live pg_get_constraintdef text (F-016/F-025 lessons).
      EMPTY <rollback/> everywhere: a real rollback would DROP live tables that were merely MARK_RANed.
    -->

    <!-- ===== PASS 1 - TABLES (16) ===== -->
    <changeSet id="chat" author="table-baseline" dbms="postgresql">
