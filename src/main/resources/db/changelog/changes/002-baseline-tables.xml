        <createTable tableName="chat">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="BY DEFAULT">
                <constraints primaryKey="true" primaryKeyName="chat_pkey" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
