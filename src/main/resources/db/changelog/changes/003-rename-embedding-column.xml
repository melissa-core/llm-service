<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-07-10-rename-embedding-column" author="jahongir">

        <preConditions onFail="HALT">
            <tableExists tableName="embedding_details"/>
            <columnExists
                    tableName="embedding_details"
                    columnName="embedding"/>
        </preConditions>

        <renameColumn
                tableName="embedding_details"
                oldColumnName="embedding"
                newColumnName="embeddings"
                columnDataType="jsonb"/>

        <rollback>
            <renameColumn
                    tableName="embedding_details"
                    oldColumnName="embeddings"
                    newColumnName="embedding"
                    columnDataType="jsonb"/>
        </rollback>

    </changeSet>

</databaseChangeLog>